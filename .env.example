# Vercel deployments can use the project's automatic VERCEL_OIDC_TOKEN.
# For local AI Gateway use:
AI_GATEWAY_API_KEY=
OUTSIDE_PLANNER_MODEL=openai/gpt-6-luna
OUTSIDE_VISION_MODEL=google/gemini-4-argon
OUTSIDE_PLANNER_FALLBACK_MODEL=google/gemini-4-argon
